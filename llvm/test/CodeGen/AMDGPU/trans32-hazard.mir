# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -run-pass=machine-scheduler -amdgpu-sched-strategy=ml -amdgpu-print-schedule-metrics -o - %s 2>&1 | FileCheck %s

# Test that the scheduler avoids the TRANS32 hazard by reordering S_MOV before V_SIN.
# The TRANS32 hazard occurs when a non-VALU instruction immediately follows a transcendental.
# CHECK-LABEL: name: test_trans32_hazard_salu
# CHECK: dead %2:sgpr_32 = S_MOV_B32 0
# CHECK: dead %1:vgpr_32 = V_SIN_F32_e32
---
name:            test_trans32_hazard_salu
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  bb.0:
    liveins: $vgpr0
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = V_SIN_F32_e32 %0, implicit $exec, implicit $mode
    %2:sgpr_32 = S_MOV_B32 0
    S_ENDPGM 0
...

# Test that VALU after TRANS32 doesn't cause a hazard - scheduler keeps the order.
# CHECK-LABEL: name: test_trans32_no_hazard_valu
# CHECK: dead %1:vgpr_32 = V_SIN_F32_e32
# CHECK: dead %2:vgpr_32 = V_ADD_F32_e32
---
name:            test_trans32_no_hazard_valu
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  bb.0:
    liveins: $vgpr0
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = V_SIN_F32_e32 %0, implicit $exec, implicit $mode
    %2:vgpr_32 = V_ADD_F32_e32 %0, %0, implicit $exec, implicit $mode
    S_ENDPGM 0
...

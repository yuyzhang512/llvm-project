; A register named by llvm.{read,write}_register and read in a block that does
; not write it is not reserved: it is a live-in of the blocks that read it. Each
; function puts such a register in front of a different pre-RA pass.

; Written before the loop, read and written in it: live into the loop header.
define amdgpu_kernel void @loop_acc(ptr addrspace(1) %out, i32 %n, i32 %a, i32 %b) {
; CHECK-LABEL: loop_acc:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    s_load_dword s0, s[4:5], 0x8
; CHECK-NEXT:    v_and_b32_e32 v0, 0x3ff, v0
; CHECK-NEXT:    s_mov_b32 s1, 0
; CHECK-NEXT:    v_mov_b32_e32 v8, v0
; CHECK-NEXT:    s_waitcnt lgkmcnt(0)
; CHECK-NEXT:    s_cmp_ge_i32 s1, s0
; CHECK-NEXT:    s_cbranch_scc1 .LBB0_2
; CHECK-NEXT:  .LBB0_1: ; %body
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    v_add_u32_e32 v8, s1, v8
; CHECK-NEXT:    s_add_i32 s1, s1, 1
; CHECK-NEXT:    s_cmp_ge_i32 s1, s0
; CHECK-NEXT:    s_cbranch_scc0 .LBB0_1
; CHECK-NEXT:  .LBB0_2: ; %exit
; CHECK-NEXT:    s_load_dwordx2 s[0:1], s[4:5], 0x0
; CHECK-NEXT:    v_lshlrev_b32_e32 v0, 2, v0
; CHECK-NEXT:    s_waitcnt lgkmcnt(0)
; CHECK-NEXT:    global_store_dword v0, v8, s[0:1]
; CHECK-NEXT:    s_endpgm
entry:
  %t = call i32 @llvm.amdgcn.workitem.id.x()
  call void @llvm.write_register.i32(metadata !0, i32 %t)
  br label %header
header:
  %i = phi i32 [ 0, %entry ], [ %i1, %body ]
  %c = icmp slt i32 %i, %n
  br i1 %c, label %body, label %exit
body:
  %r = call i32 @llvm.read_register.i32(metadata !0)
  %s = add i32 %r, %i
  call void @llvm.write_register.i32(metadata !0, i32 %s)
  %i1 = add i32 %i, 1
  br label %header
exit:
  %e = call i32 @llvm.read_register.i32(metadata !0)
  %p = getelementptr i32, ptr addrspace(1) %out, i32 %t
  store i32 %e, ptr addrspace(1) %p
  ret void
}


# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx900 -run-pass=machine-scheduler -verify-machineinstrs -o - %s | FileCheck %s

# The scheduler may reorder the two lane copies of %2. Whichever comes first
# defines the register; the one after it reads the lane already written, so
# only the first may carry read-undef.

---
name:            lane_copies_from_physregs
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $sgpr16, $sgpr17

    ; CHECK-LABEL: name: lane_copies_from_physregs
    ; CHECK: liveins: $sgpr16, $sgpr17
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: undef [[COPY:%[0-9]+]].sub1:sgpr_64 = COPY $sgpr17
    ; CHECK-NEXT: [[COPY:%[0-9]+]].sub0:sgpr_64 = COPY $sgpr16
    ; CHECK-NEXT: [[V_MOV_B32_e32_:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    ; CHECK-NEXT: INLINEASM &"; def $0, $1", attdialect, regdef, implicit-def $vgpr4, regdef, implicit-def $vgpr5
    ; CHECK-NEXT: undef [[COPY1:%[0-9]+]].sub0:vreg_64 = COPY $vgpr5
    ; CHECK-NEXT: [[COPY1:%[0-9]+]].sub1:vreg_64 = COPY $vgpr4
    ; CHECK-NEXT: GLOBAL_STORE_DWORDX2_SADDR [[V_MOV_B32_e32_]], [[COPY1]], [[COPY]], 0, 0, implicit $exec :: (store (s64), addrspace 1)
    ; CHECK-NEXT: SI_RETURN
    undef %0.sub1:sgpr_64 = COPY $sgpr17
    %0.sub0:sgpr_64 = COPY $sgpr16
    %1:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    INLINEASM &"; def $0, $1", attdialect, regdef, implicit-def $vgpr4, regdef, implicit-def $vgpr5
    undef %2.sub1:vreg_64 = COPY killed $vgpr4
    %2.sub0:vreg_64 = COPY killed $vgpr5
    GLOBAL_STORE_DWORDX2_SADDR %1, %2, %0, 0, 0, implicit $exec :: (store (s64), addrspace 1)
    SI_RETURN
...

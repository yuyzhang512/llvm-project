; Promoting an alloca marked !llvm.pin.register pins each value stored to it,
; so the request survives the alloca. A value already pinned to the register is
; left alone.

define i32 @f(i32 %a, i32 %b, i1 %c) {
; CHECK-LABEL: define i32 @f(
; CHECK-SAME: i32 [[A:%.*]], i32 [[B:%.*]], i1 [[C:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[TMP0:%.*]] = call i32 @llvm.pin.register.i32(i32 [[A]], metadata [[META0:![0-9]+]], i1 true)
; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[EXIT:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    [[P:%.*]] = call i32 @llvm.pin.register.i32(i32 [[B]], metadata [[META0]], i1 true)
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[X_0:%.*]] = phi i32 [ [[P]], %[[THEN]] ], [ [[TMP0]], %[[ENTRY]] ]
; CHECK-NEXT:    ret i32 [[X_0]]
;
entry:
  %x = alloca i32, align 4, !llvm.pin.register !0
  store i32 %a, ptr %x
  br i1 %c, label %then, label %exit
then:
  %p = call i32 @llvm.pin.register.i32(i32 %b, metadata !1, i1 true)
  store i32 %p, ptr %x
  br label %exit
exit:
  %r = load i32, ptr %x
  ret i32 %r
}

!0 = !{!"v8", i1 true}
!1 = !{!"v8"}

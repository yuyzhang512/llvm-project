; A required pin writes the register; uses read it where it still holds the
; value, and keep the value where it may not.

declare void @ext()

; The later block reads the register: nothing else wrote it.
define void @cross_block(ptr %p, i32 %v, i1 %c) {
; CHECK-LABEL: define void @cross_block(
; CHECK-SAME: ptr [[P:%.*]], i32 [[V:%.*]], i1 [[C:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    call void @llvm.write_register.i32(metadata [[META0:![0-9]+]], i32 [[V]])
; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[EXIT:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    [[TMP0:%.*]] = call i32 @llvm.read_register.i32(metadata [[META0]])
; CHECK-NEXT:    store i32 [[TMP0]], ptr [[P]], align 4
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %r = call i32 @llvm.pin.register.i32(i32 %v, metadata !0, i1 true)
  br i1 %c, label %then, label %exit
then:
  store i32 %r, ptr %p
  br label %exit
exit:
  ret void
}

; A second pin to the same register comes in between: keep the value.
define void @stale(ptr %p, i32 %v, i32 %w, i1 %c) {
; CHECK-LABEL: define void @stale(
; CHECK-SAME: ptr [[P:%.*]], i32 [[V:%.*]], i32 [[W:%.*]], i1 [[C:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    call void @llvm.write_register.i32(metadata [[META0]], i32 [[V]])
; CHECK-NEXT:    call void @llvm.write_register.i32(metadata [[META0]], i32 [[W]])
; CHECK-NEXT:    [[TMP0:%.*]] = call i32 @llvm.read_register.i32(metadata [[META0]])
; CHECK-NEXT:    store i32 [[TMP0]], ptr [[P]], align 4
; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[EXIT:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    store i32 [[V]], ptr [[P]], align 4
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %r = call i32 @llvm.pin.register.i32(i32 %v, metadata !0, i1 true)
  %s = call i32 @llvm.pin.register.i32(i32 %w, metadata !0, i1 true)
  store i32 %s, ptr %p
  br i1 %c, label %then, label %exit
then:
  store i32 %r, ptr %p
  br label %exit
exit:
  ret void
}

; A call may clobber the register: keep the value after it.
define void @call(ptr %p, i32 %v) {
; CHECK-LABEL: define void @call(
; CHECK-SAME: ptr [[P:%.*]], i32 [[V:%.*]]) {
; CHECK-NEXT:    call void @llvm.write_register.i32(metadata [[META0]], i32 [[V]])
; CHECK-NEXT:    call void @ext()
; CHECK-NEXT:    store i32 [[V]], ptr [[P]], align 4
; CHECK-NEXT:    ret void
;
  %r = call i32 @llvm.pin.register.i32(i32 %v, metadata !0, i1 true)
  call void @ext()
  store i32 %r, ptr %p
  ret void
}

; A loop accumulator: the PHI arrives in the register from both edges.
define i32 @loop(i32 %n) {
; CHECK-LABEL: define i32 @loop(
; CHECK-SAME: i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    call void @llvm.write_register.i32(metadata [[META0]], i32 0)
; CHECK-NEXT:    br label %[[BODY:.*]]
; CHECK:       [[BODY]]:
; CHECK-NEXT:    [[ACC:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[A:%.*]], %[[BODY]] ]
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I1:%.*]], %[[BODY]] ]
; CHECK-NEXT:    [[TMP0:%.*]] = call i32 @llvm.read_register.i32(metadata [[META0]])
; CHECK-NEXT:    [[A]] = add i32 [[TMP0]], [[I]]
; CHECK-NEXT:    call void @llvm.write_register.i32(metadata [[META0]], i32 [[A]])
; CHECK-NEXT:    [[I1]] = add i32 [[I]], 1
; CHECK-NEXT:    [[C:%.*]] = icmp slt i32 [[I1]], [[N]]
; CHECK-NEXT:    br i1 [[C]], label %[[BODY]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[TMP1:%.*]] = call i32 @llvm.read_register.i32(metadata [[META0]])
; CHECK-NEXT:    ret i32 [[TMP1]]
;
entry:
  %z = call i32 @llvm.pin.register.i32(i32 0, metadata !0, i1 true)
  br label %body
body:
  %acc = phi i32 [ %z, %entry ], [ %next, %body ]
  %i = phi i32 [ 0, %entry ], [ %i1, %body ]
  %a = add i32 %acc, %i
  %next = call i32 @llvm.pin.register.i32(i32 %a, metadata !0, i1 true)
  %i1 = add i32 %i, 1
  %c = icmp slt i32 %i1, %n
  br i1 %c, label %body, label %exit
exit:
  ret i32 %next
}

; The hint form is left to instruction selection.
define i32 @hint(i32 %v) {
; CHECK-LABEL: define i32 @hint(
; CHECK-SAME: i32 [[V:%.*]]) {
; CHECK-NEXT:    [[R:%.*]] = call i32 @llvm.pin.register.i32(i32 [[V]], metadata [[META0]], i1 false)
; CHECK-NEXT:    ret i32 [[R]]
;
  %r = call i32 @llvm.pin.register.i32(i32 %v, metadata !0, i1 false)
  ret i32 %r
}

